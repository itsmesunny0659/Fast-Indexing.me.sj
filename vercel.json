{
  "version": 2,
  "name": "ai-fast-indexing-engine",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "server.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/i/(.*)",
      "headers": {
        "X-Robots-Tag": "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
      },
      "dest": "server.js"
    },
    {
      "src": "/hub/(.*)",
      "headers": {
        "X-Robots-Tag": "index, follow"
      },
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
